# Environment Variables for Retail Agent Backend

# Google Gemini API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Settings
LLM_TEMPERATURE=0.1
LLM_MODEL=gpt-4o-mini

# Optional: Database settings (if using database in future)
# DATABASE_URL=sqlite:///./retail_agent.db

# ─── WhatsApp / Twilio Integration ───
# Twilio credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Public base URL for serving product images (must be HTTPS and publicly accessible)
# Product images are at <base>/images/PRD001.jpg, PRD002.jpg, etc.
# You can use ngrok, Cloudflare Tunnel, or any static hosting service
PRODUCT_IMAGE_BASE_URL=https://yourdomain.com

# ─── Meta WhatsApp Cloud API (alternative to Twilio) ───
ACCESS_TOKEN=your_meta_access_token
APP_ID=your_meta_app_id
APP_SECRET=your_meta_app_secret
RECIPIENT_WAID=your_test_recipient
VERSION=v18.0
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=your_verify_token
