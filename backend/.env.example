# Environment Variables for Retail Agent Backend

# OpenAI API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Settings (Optional - uncomment to customize)
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3

# Google Maps API Key (Required)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# WhatsApp/Meta Configuration
# This token expires after 24 hours. You can get a new one from the your Meta App Dashboard > API Setup
# Or you can create an access token at the System User level from the Meta Business Settings: https://business.facebook.com/settings/system-users
ACCESS_TOKEN=your_meta_access_token_here

APP_ID=your_meta_app_id_here
APP_SECRET=your_meta_app_secret_here
RECIPIENT_WAID=+1234567890 # Your WhatsApp number with country code (e.g., +31612345678)
VERSION=v18.0
PHONE_NUMBER_ID=your_phone_number_id_here

VERIFY_TOKEN=your_verify_token_here

# OpenAI Assistant ID (Required)
OPENAI_ASSISTANT_ID=your_openai_assistant_id_here
