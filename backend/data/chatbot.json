{
  "welcome_message": "Welcome to your AI Shopping Assistant! 🛍️",
  "introduction": {
    "greeting": "Hi! I'm your intelligent shopping assistant powered by specialized agents.",
    "capabilities": [
      "🔍 Search & Discovery - Find products from our catalog",
      "🎁 Smart Recommendations - Personalized product displays",
      "🛒 Cart Management - Add, view, and remove items",
      "🛍️ Channel Selection - Choose online delivery or store pickup",
      "💳 Secure Payment - Multiple payment options",
      "📦 Order Fulfillment - Track your delivery or pickup",
      "⭐ Loyalty Rewards - Earn points on every purchase",
      "💬 Post-Purchase Support - Tracking, returns & assistance"
    ],
    "prompt": "How can I help you shop today?"
  },
  "workflow": {
    "steps": [
      "Search products",
      "Add to cart",
      "View/manage cart",
      "Choose channel (online/offline)",
      "Payment (online) or Store selection (offline)",
      "Fulfillment",
      "Loyalty & Support (online only)"
    ],
    "channels": {
      "online": {
        "flow": "Payment → Fulfillment → Loyalty → Post-Purchase",
        "benefits": ["Home delivery", "Loyalty points", "Order tracking", "Post-purchase support"]
      },
      "offline": {
        "flow": "Store Selection → Fulfillment",
        "benefits": ["Store pickup", "No delivery wait", "Pay at store"]
      }
    }
  },
  "agents": [
    {
      "agentId": "inventory_agent",
      "title": "Inventory Agent",
      "description": "Searches products from database and checks availability",
      "status": "active",
      "action": "Searching products in database...",
      "output": {
        "search_results": {
          "status": "success",
          "message": "✅ Found {count} products matching your search",
          "products": [
            {
              "product_id": "PRD014",
              "product_name": "Biba Kurti Set",
              "category": "Kurti Set",
              "quantity": 60,
              "price": 3299.0,
              "image_reference": "/images/PRD014.jpg",
              "description": null
            }
          ]
        },
        "product_availability": {
          "status": "in_stock",
          "message": "✅ Product {product_id} is IN STOCK!",
          "product_name": "{product_name}",
          "price": "{price}",
          "quantity": "{available_quantity}"
        },
        "offline_stores": {
          "message": "📍 Available Stores for Pickup:",
          "stores": [
            {
              "store_id": "STR016",
              "store_name": "South City Mall Second Floor",
              "location": "South City Mall, 2nd Floor, Kolkata",
              "distance": "4.5 km away",
              "stock": "Available"
            },
            {
              "store_id": "STR011",
              "store_name": "ABFRL Store South City",
              "location": "ABFRL Store, South City Mall, Kolkata",
              "distance": "7.5 km away",
              "stock": "Available"
            }
          ]
        }
      }
    },
    {
      "agentId": "recommendation_agent",
      "title": "Recommendation Agent",
      "description": "Displays products in beautiful UI-friendly format",
      "status": "pending",
      "action": "Formatting product recommendations...",
      "output": {
        "message": "🛍️ Here are {count} products I found for you! **{first_product_name}** is ₹{price} and in stock ({quantity} available).",
        "prompt": "Would you like to **add any of these to your cart** with quantity, or do you want to **browse more products**?",
        "recommendations": [
          {
            "product_id": "PRD014",
            "product_name": "Biba Kurti Set",
            "price": 3299.0,
            "category": "Kurti Set",
            "quantity": 60,
            "image_reference": "/images/PRD014.jpg",
            "description": null
          },
          {
            "product_id": "PRD018",
            "product_name": "Global Desi Kurti",
            "price": 2599.0,
            "category": "Kurti",
            "quantity": 135,
            "image_reference": "/images/PRD018.jpg",
            "description": null
          }
        ]
      }
    },
    {
      "agentId": "add_to_cart_agent",
      "title": "Add to Cart Agent",
      "description": "Adds products to customer's cart with specified quantity",
      "status": "pending",
      "action": "Adding product to cart...",
      "output": {
        "status": "success",
        "message": "✅ **Added to Cart!**",
        "product": {
          "product_id": "{product_id}",
          "product_name": "{product_name}",
          "quantity": "{quantity}",
          "price_per_unit": "{price}",
          "total": "{total}"
        },
        "prompt": "Would you like to **add more products** to your cart or **proceed to view your cart**?"
      }
    },
    {
      "agentId": "view_cart_agent",
      "title": "View Cart Agent",
      "description": "Displays all items in customer's cart with totals",
      "status": "pending",
      "action": "Loading your cart...",
      "output": {
        "message": "🛒 **Your Shopping Cart**",
        "total_items": "{count}",
        "cart_items": [
          {
            "order_id": "CART275679240",
            "product_id": "PRD056",
            "product_name": "W Global Women Kurti",
            "quantity": 2,
            "price_per_unit": 1899,
            "total": 3798
          }
        ],
        "total_amount": "{total_amount}",
        "actions": [
          "Type 'proceed' to continue to payment",
          "Type 'add more' to browse more products",
          "To remove an item, provide the Order ID"
        ]
      }
    },
    {
      "agentId": "remove_from_cart_agent",
      "title": "Remove from Cart Agent",
      "description": "Removes items from cart by order ID",
      "status": "pending",
      "action": "Removing item from cart...",
      "output": {
        "status": "success",
        "message": "✅ Removed **{product_name}** from your cart.",
        "prompt": "Would you like to view your updated cart?"
      }
    },
    {
      "agentId": "choose_channel_agent",
      "title": "Choose Channel Agent",
      "description": "Presents online vs offline purchase options",
      "status": "pending",
      "action": "Preparing purchase options...",
      "output": {
        "message": "🛍️ **Choose Your Purchase Channel**",
        "cart_summary": {
          "total_items": "{count}",
          "total_amount": "{total}"
        },
        "channels": [
          {
            "channel": "online",
            "icon": "🌐",
            "title": "ONLINE",
            "subtitle": "Home delivery (3-5 business days)",
            "benefits": [
              "Secure online payment",
              "Track your order",
              "Earn loyalty points & coupons"
            ]
          },
          {
            "channel": "offline",
            "icon": "🏪",
            "title": "OFFLINE",
            "subtitle": "Store pickup (Ready in 2 hours)",
            "benefits": [
              "Pay at store",
              "Pick up from nearest location",
              "Instant product availability check"
            ]
          }
        ],
        "prompt": "Please type **'online'** or **'offline'** to continue."
      }
    },
    {
      "agentId": "payment_agent",
      "title": "Payment Agent",
      "description": "Handles payment processing - two-stage process",
      "status": "pending",
      "action": "Waiting for payment method selection...",
      "inputRequired": true,
      "output": {
        "stage_1_show_options": {
          "message": "💳 **Payment for Your Cart**",
          "cart_summary": {
            "total_items": "{count}",
            "total_amount": "{total}"
          },
          "payment_methods": [
            {
              "method": "upi",
              "icon": "📱",
              "title": "UPI",
              "description": "Pay using any UPI app (Google Pay, PhonePe, Paytm, etc.)"
            },
            {
              "method": "credit card",
              "icon": "💳",
              "title": "Credit Card",
              "description": "Visa, Mastercard, American Express, etc."
            },
            {
              "method": "debit card",
              "icon": "💳",
              "title": "Debit Card",
              "description": "All major banks supported"
            },
            {
              "method": "net banking",
              "icon": "🏦",
              "title": "Net Banking",
              "description": "Direct bank transfer"
            }
          ],
          "prompt": "Which payment method would you like to use?"
        },
        "stage_2_process_payment": {
          "status": "processing",
          "message": "💳 **Processing Payment...**",
          "transaction": {
            "order_id": "{order_id}",
            "total_items": "{count}",
            "amount": "{total}",
            "method": "{payment_method}",
            "payment_id": "{payment_id}"
          },
          "success": {
            "status": "completed",
            "message": "✅ **Payment Successful!**",
            "next_action": "Your order is being processed..."
          }
        }
      }
    },
    {
      "agentId": "fulfillment_agent",
      "title": "Fulfillment Agent",
      "description": "Handles order fulfillment for online delivery or offline store pickup",
      "status": "pending",
      "action": "Scheduling delivery...",
      "output": {
        "online_delivery": {
          "message": "📦 **Order Confirmed!**",
          "order_details": {
            "order_id": "{order_id}",
            "total_items": "{count}",
            "total_amount": "{total}",
            "delivery_type": "Home Delivery",
            "expected_delivery": "3-5 business days"
          },
          "tracking": {
            "enabled": true,
            "message": "You can track your order with the Order ID."
          }
        },
        "offline_store_pickup": {
          "message": "🏪 **In-Store Pickup Confirmed!**",
          "order_details": {
            "order_id": "{order_id}",
            "total_items": "{count}",
            "total_amount": "{total}",
            "pickup_store": "{store_name}",
            "store_address": "{store_address}",
            "status": "Ready for pickup in 2 hours"
          },
          "items": [
            {
              "product_name": "{product_name}",
              "quantity": "{quantity}"
            }
          ],
          "instructions": {
            "message": "Please visit the store to complete your purchase.",
            "note": "💡 Show this Order ID at the store kiosk."
          },
          "closing": "Thank you for choosing us! Have a great day! 🛍️"
        }
      }
    },
    {
      "agentId": "loyalty_agent",
      "title": "Loyalty & Offers Agent",
      "description": "Awards loyalty points based on purchase and generates coupon codes",
      "status": "pending",
      "action": "Applying points & coupons...",
      "note": "ONLINE PURCHASES ONLY - Called automatically after online fulfillment",
      "output": {
        "message": "🎉 **Loyalty Rewards Unlocked!**",
        "order_id": "{order_id}",
        "points": {
          "earned": "{points}",
          "icon": "🌟",
          "calculation": "Calculated from product loyalty_points × quantity and added to customer's total"
        },
        "coupons": [
          {
            "code": "{code1}",
            "discount": "10% off"
          },
          {
            "code": "{code2}",
            "discount": "₹100 off"
          },
          {
            "code": "{code3}",
            "discount": "Extra ₹50 off on next order"
          }
        ],
        "message_closing": "Thank you for shopping with us!"
      }
    },
    {
      "agentId": "post_purchase_agent",
      "title": "Post Purchase Agent",
      "description": "Provides post-purchase services like tracking, feedback, and support",
      "status": "pending",
      "action": "Asking for feedback...",
      "note": "ONLINE PURCHASES ONLY - Called automatically after loyalty_agent",
      "output": {
        "message": "📝 **Post-Purchase Services**",
        "order_id": "{order_id}",
        "services": [
          {
            "icon": "📊",
            "title": "Track Order",
            "description": "Real-time delivery updates",
            "link": "https://example.com/track/{order_id}",
            "status": "Active"
          },
          {
            "icon": "⭐",
            "title": "Leave Feedback",
            "description": "Share your experience & earn reward points",
            "link": "https://example.com/feedback",
            "status": "Ready"
          },
          {
            "icon": "💬",
            "title": "Customer Support",
            "description": "Live chat, email & phone support available",
            "contact": "support@example.com",
            "status": "Online"
          },
          {
            "icon": "🔄",
            "title": "Return/Exchange",
            "description": "30-day hassle-free return policy",
            "availability": "Available within 7 days",
            "status": "Active"
          }
        ],
        "prompt": "We'd love to hear your feedback! Please rate your experience.",
        "options": ["Give Feedback", "Request Return"]
      }
    }
  ],
  "usage_examples": [
    {
      "step": 1,
      "title": "Search Products",
      "user_input": "show me kurti and shorts",
      "agents_triggered": ["inventory_agent", "recommendation_agent"],
      "expected_output": "Displays products with images, prices, quantities, and asks to add to cart"
    },
    {
      "step": 2,
      "title": "Add to Cart",
      "user_input": "add PRD001 quantity 2 and PRD002 quantity 3",
      "agents_triggered": ["add_to_cart_agent"],
      "expected_output": "Confirms both products added with quantities and prices"
    },
    {
      "step": 3,
      "title": "View Cart",
      "user_input": "view cart",
      "agents_triggered": ["view_cart_agent"],
      "expected_output": "Shows all cart items with order IDs, quantities, prices, and total amount"
    },
    {
      "step": 4,
      "title": "Remove Items",
      "user_input": "remove CART275679240 and CART532177776",
      "agents_triggered": ["remove_from_cart_agent"],
      "expected_output": "Confirms items removed from cart"
    },
    {
      "step": 5,
      "title": "Choose Channel",
      "user_input": "proceed",
      "agents_triggered": ["choose_channel_agent"],
      "expected_output": "Shows online (home delivery + loyalty) vs offline (store pickup) options"
    },
    {
      "step": "6a",
      "title": "Online Payment - Show Options",
      "user_input": "online",
      "agents_triggered": ["payment_agent"],
      "expected_output": "Displays 4 payment methods: UPI, Credit Card, Debit Card, Net Banking"
    },
    {
      "step": "6b",
      "title": "Online Payment - Process",
      "user_input": "upi",
      "agents_triggered": ["payment_agent"],
      "expected_output": "Processes payment and returns Payment Successful with order ID"
    },
    {
      "step": "7a",
      "title": "Online Fulfillment",
      "user_input": "[automatic after payment]",
      "agents_triggered": ["fulfillment_agent", "loyalty_agent", "post_purchase_agent"],
      "expected_output": "Order confirmation → Loyalty points earned → Post-purchase services"
    },
    {
      "step": "6c",
      "title": "Offline - Show Stores",
      "user_input": "offline",
      "agents_triggered": ["inventory_agent"],
      "expected_output": "Shows available stores with IDs and distances"
    },
    {
      "step": "7b",
      "title": "Offline Fulfillment",
      "user_input": "ABFRL Store South City",
      "agents_triggered": ["fulfillment_agent"],
      "expected_output": "In-store pickup confirmation with order ID to show at kiosk. No loyalty/post-purchase."
    }
  ],
  "flow_comparison": {
    "online": {
      "sequence": ["Channel Selection", "Payment Options", "Payment Processing", "Fulfillment", "Loyalty Rewards", "Post-Purchase"],
      "features": {
        "loyalty_points": true,
        "order_tracking": true,
        "home_delivery": true,
        "post_purchase_support": true
      },
      "delivery_time": "3-5 business days"
    },
    "offline": {
      "sequence": ["Channel Selection", "Store Selection", "Fulfillment"],
      "features": {
        "loyalty_points": false,
        "order_tracking": false,
        "store_pickup": true,
        "post_purchase_support": false
      },
      "pickup_time": "Ready in 2 hours"
    }
  },
  "fallback": {
    "message": "I'm sorry, I didn't understand that. Could you please rephrase or choose from:",
    "suggestions": [
      "Search products",
      "Add to cart",
      "View cart",
      "Proceed to checkout"
    ]
  }
}